# Copiar este archivo como .env y ajustar si es necesario

PORT=3000
HOST=0.0.0.0

# ethereal (por defecto) | smtp | simulado
MAIL_MODE=ethereal
MAIL_FROM="PetCare" <no-reply@petcare.cl>

# Solo si MAIL_MODE=smtp (por ejemplo Gmail con contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
